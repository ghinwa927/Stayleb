"use client";
import { LocalImage } from "@/components/ui/LocalImage";
import Link from "next/link";
import { useRouter, usePathname } from "next/navigation";
import { Icon } from "@/components/ui/Icon";
import { ActionButton } from "@/components/ui/Interactions";
import { requireAuth } from "@/lib/authGuard";

export function PropertyDetailsSection0() {
  const router = useRouter();
  const pathname = usePathname();
  const handleFavorite = () => {
    if (!requireAuth({ nextPath: pathname, action: "favorites", router })) return;
    // For authenticated users, toggle favorite via existing localStorage logic
    const key = "cedar-peak";
    const saved: string[] = JSON.parse(localStorage.getItem("stayleb-saved-property-ids") || '["batroun-sunset","cedar-peak","azure-horizon"]');
    const active = saved.includes(key);
    localStorage.setItem("stayleb-saved-property-ids", JSON.stringify(active ? saved.filter((v) => v !== key) : [...saved, key]));
    window.dispatchEvent(new Event("stayleb-favorites"));
  };
  const handleBooking = () => {
    const nextPath = "/book/cedar-peak";
    if (!requireAuth({ nextPath, action: "booking", router })) return;
    router.push(nextPath);
  };
  return <>
