"use client";
import { LocalImage } from "@/components/ui/LocalImage";
import { useBooking,money } from './BookingContext';
import { Icon } from '@/components/ui/Icon';
import { properties } from '@/lib/mock-data/properties';
export function PropertyIdentity({hero=false}:{hero?:boolean}) { const property=properties[0];return <div className={hero?'':'flex gap-4 items-center'}><LocalImage src={property.image} alt="Cedar Peak Stone Chalet overlooking the Faraya mountains" className={hero?'w-full h-48 object-cover rounded-xl mb-4':'w-24 h-20 object-cover rounded-lg'} /><div><span className="text-[10px] uppercase tracking-wider text-primary font-bold">Verified Superhost</span><h2 className="font-semibold mt-1">{property.name}</h2><p className="text-xs text-on-surface-variant mt-1">⌖ {property.location}</p><span className="text-xs text-primary">★ {property.rating} (42 reviews)</span></div></div>; }
export function BookingSummary() { const {stay,nights,lodging,total}=useBooking();return <aside className="space-y-4"><div className="panel"><PropertyIdentity hero /><div className="bg-surface-container-low rounded-lg p-4 mt-5 grid grid-cols-2 gap-4 text-xs"><div><span className="text-slate-500 block text-[10px] mb-1">CHECK-IN</span>{stay.checkIn}</div><div><span className="text-slate-500 block text-[10px] mb-1">CHECK-OUT</span>{stay.checkOut}</div><span>{nights} nights</span><span>{stay.adults+stay.children} guests</span></div><h3 className="text-xs tracking-wider uppercase mt-6 mb-4">Price breakdown</h3><dl className="space-y-3 text-xs"><div className="flex justify-between"><dt>Chalet stay ({nights} nights)</dt><dd>{money(lodging)}</dd></div><div className="flex justify-between"><dt>Cleaning & firewood</dt><dd>$40.00</dd></div><div className="flex justify-between"><dt>Service & secure processing</dt><dd className="text-primary">Waived ($0.00)</dd></div><div className="flex justify-between bg-surface-container-low p-4 rounded-lg text-base font-semibold"><dt>Total due {stay.method==='Cash'?'on arrival':'now'}</dt><dd className="text-primary">{money(total)}</dd></div></dl><p className="text-[11px] mt-4 text-slate-500">USD · All taxes included. No hidden platform markup.</p></div><div className="panel flex gap-3 text-xs"><Icon name="verified_user" className="text-primary" /><div><strong>StayLeb Escrow Protection Shield</strong><p className="mt-1 text-slate-500">Your payment is protected. Funds are released 24 hours after smooth check-in.</p></div></div><div className="panel flex gap-3 text-xs"><Icon name="support_agent" className="text-primary" /><div><strong>Need immediate assistance?</strong><p className="text-slate-500 mt-1">Local Lebanon support, available 24/7.</p></div></div></aside>; }
export function BookingProgress({step}:{step:number}) {return <div className="flex flex-wrap justify-between gap-4 text-xs mb-7"><div className="text-slate-500">Discover <span className="mx-2">›</span> Faraya Mzaar <span className="mx-2">›</span> Cedar Peak Stone Chalet</div><ol aria-label="Booking progress" className="flex gap-4">{['Stay Details','Price & Review','Payment'].map((title,index)=><li key={title} aria-current={step===index+1?'step':undefined} className={step>=index+1?'text-primary':'text-slate-400'}><span className={`rounded-full inline-grid place-items-center w-4 h-4 mr-1 text-[10px] ${step>=index+1?'bg-primary text-white':'bg-surface-container'}`}>{index+1}</span>{title}</li>)}</ol></div>; }
