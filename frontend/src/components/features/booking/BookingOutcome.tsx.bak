"use client";
import Link from 'next/link';
import {useBooking,money} from './BookingContext';
import {PropertyIdentity,BookingSummary} from './BookingSummary';
import {Icon} from '@/components/ui/Icon';
export function BookingConfirmed(){const {stay,nights,total}=useBooking();return <main className="max-w-2xl mx-auto p-5 md:p-8 space-y-5"><section className="panel text-center bg-gradient-to-br from-white to-cyan-50"><span className="inline-grid place-items-center h-14 w-14 rounded-full bg-cyan-100 text-primary mb-4"><Icon name="check" className="text-3xl"/></span><p className="text-xs text-primary">Instant Stripe Confirmation</p><h1 className="text-3xl font-semibold mt-3">Booking Confirmed!</h1><p className="text-sm text-slate-500 mt-3">Your mountain reservation at Cedar Peak Stone Chalet is locked in.</p><div className="bg-surface-container-low p-4 mt-6 rounded-lg">REF CODE: <strong>#SLB-84920</strong><span className="ml-3 text-xs text-primary">✓ Confirmed & Guaranteed</span></div></section><section className="panel"><PropertyIdentity hero/><div className="grid grid-cols-2 gap-5 mt-5 text-sm"><div><span className="block text-xs text-slate-500">Check-in</span>{stay.checkIn} · From 15:00</div><div><span className="block text-xs text-slate-500">Check-out</span>{stay.checkOut} · Before 11:00</div><div>{nights} nights · {stay.adults+stay.children} guests</div><div>Hosted by Tony & Carole</div></div></section><section className="panel"><h2 className="font-semibold">Receipt Breakdown</h2><div className="flex justify-between mt-5 bg-surface-container-low p-5 rounded-lg"><span>Total Billed to Card</span><strong className="text-primary text-xl">{money(total)} USD</strong></div><p className="text-xs text-slate-500 mt-4">Demo receipt · No payment was processed.</p></section><div className="flex flex-wrap gap-3 justify-between"><Link href="/" className="secondary-button">← Return to Discover</Link><button className="secondary-button" onClick={()=>window.print()}>Download / Print Receipt</button><Link href="/account/bookings" className="primary-button">View in My Bookings</Link></div></main>;}
export function PaymentFailed(){return <main className="max-w-3xl mx-auto p-5 md:p-8 space-y-5"><section className="panel"><span className="text-error text-xs">⚠ Stripe Authorization Unsuccessful</span><h1 className="text-3xl font-semibold mt-3">Payment Couldn’t Be Completed</h1><p className="text-sm text-slate-500 mt-3">Your bank or card issuer was unable to authorize this demonstration transaction.</p><div className="p-5 bg-surface-container-low rounded-lg mt-5"><strong className="text-primary">Your booking has NOT been confirmed.</strong><p className="text-xs mt-2">No charges were made. Choose a recovery option below to continue.</p></div></section><div className="grid md:grid-cols-2 gap-5"><section className="panel space-y-4"><h2 className="text-lg font-semibold">Choose Recovery Action</h2><p className="text-sm text-slate-500">Select how you’d like to preserve your chalet dates.</p><Link href="/book/cedar-peak/payment" className="primary-button w-full">Try Payment Again →</Link><Link href="/book/cedar-peak/payment-method" className="secondary-button w-full">Pay Cash on Arrival (USD) →</Link><Link href="/properties/cedar-peak" className="block text-xs">‹ Cancel & Return to Property Listing</Link></section><div className="panel"><PropertyIdentity hero/></div></div></main>;}
export function CashRequest({pending=false}:{pending?:boolean}){const {stay,total}=useBooking();return <main className="booking-main"><div className="booking-grid"><div className="space-y-5"><section className="panel border-t-4 border-primary"><span className="text-xs text-amber-700 bg-amber-50 px-3 py-1 rounded-full">⌛ Pending Owner Approval</span><h1 className="text-2xl font-semibold mt-4">{pending?'Pending Cash Booking':'Cash Booking Request Sent!'}</h1><p className="text-sm text-slate-500 mt-3">Your request for Cedar Peak Stone Chalet has been safely delivered to Tony K. The owner has a maximum of 12 hours to review and accept your reservation.</p></section><div className="p-5 rounded-xl bg-amber-50 text-amber-900 text-sm"><strong>Important: This booking is NOT confirmed yet.</strong><p className="mt-2">Your requested dates are temporarily held. Once approved by Tony, you will pay {money(total)} in cash directly to the owner upon check-in.</p></div><section className="panel"><h2 className="font-semibold mb-5">Reservation Summary</h2><PropertyIdentity/><dl className="space-y-4 mt-6 text-sm"><div className="flex justify-between"><dt>Dates Requested</dt><dd>{stay.checkIn} → {stay.checkOut}</dd></div><div className="flex justify-between"><dt>Guests</dt><dd>{stay.adults+stay.children}</dd></div><div className="flex justify-between"><dt>Payment Method</dt><dd>Cash on Arrival (USD)</dd></div><div className="flex justify-between p-4 bg-surface-container-low rounded-lg"><dt>Total to be paid in cash</dt><dd className="font-bold text-primary">{money(total)}</dd></div></dl></section><section className="panel"><h2 className="font-semibold mb-5">What Happens Next</h2><ol className="space-y-5 text-sm">{['Request Submitted — Your stay details have been sent securely to your host.','Host Review — Tony reviews your dates and party size.','Approval / Notification — You receive confirmation after host approval.','Check-in & Cash Handover — Pay the host upon arrival.'].map((step,index)=><li key={step} className="flex gap-3"><span className="w-6 h-6 shrink-0 bg-surface-container rounded-full grid place-items-center text-white">{index+1}</span>{step}</li>)}</ol></section><div className="flex gap-3 flex-wrap"><Link href="/account/bookings/stay-002/pending" className="primary-button">View Booking Request</Link><Link href="/account/bookings" className="secondary-button">Go to My Bookings</Link><Link href="/search" className="secondary-button">Explore Other Chalets →</Link></div></div><BookingSummary/></div></main>;}
