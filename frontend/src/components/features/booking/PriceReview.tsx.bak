"use client";
import Link from 'next/link';
import { useBooking,money } from './BookingContext';
import { BookingSummary,BookingProgress,PropertyIdentity } from './BookingSummary';
export function PriceReview(){const {stay,nights,lodging,total}=useBooking();return <main className="booking-main"><BookingProgress step={2}/><div className="booking-grid"><div className="space-y-5"><div className="panel"><PropertyIdentity/><div className="flex justify-between items-center mt-6 bg-surface-container-low rounded-lg p-4"><div><small>Selected itinerary</small><p>{stay.checkIn} → {stay.checkOut}</p><small>{nights} nights · {stay.adults+stay.children} registered guests</small></div><Link href="/book/cedar-peak" className="text-white text-xs">Edit Dates / Guests</Link></div></div><section className="panel"><h1 className="font-semibold text-lg">Night-by-Night Pricing Breakdown</h1><p className="text-xs text-slate-500 mt-1 mb-5">StayLeb calculates pricing per night based on owner seasonal calendars. No hidden platform markup.</p><div className="space-y-3">{Array.from({length:Math.min(nights,30)},(_,index)=>{const date=new Date(Date.parse(stay.checkIn)+index*86400000);return <div key={index} className="flex justify-between items-center bg-surface-container-low rounded-lg p-4 text-sm"><span>{date.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'UTC'})}<small className="block text-slate-500">{index%3===2?'Peak weekend mountain rate':'Standard chalet rate'}</small></span><strong>{money(index%3===2?260:220)}</strong></div>;})}</div><dl className="text-sm mt-6 space-y-3"><div className="flex justify-between"><dt>Subtotal accommodation</dt><dd>{money(lodging)}</dd></div><div className="flex justify-between"><dt>Cleaning & seasoned firewood supply</dt><dd>$40.00</dd></div><div className="flex justify-between"><dt>StayLeb service fee</dt><dd className="text-primary">Waived</dd></div><div className="flex justify-between p-5 bg-surface-container-low rounded-lg font-semibold"><dt>Total Booking Amount</dt><dd className="text-xl text-primary">{money(total)}</dd></div></dl></section><div className="grid sm:grid-cols-2 gap-4"><div className="panel"><h2 className="font-semibold">24/7 Power Guarantee</h2><p className="text-xs text-slate-500 mt-2">Your chalet is equipped with hybrid solar and inverter systems and a dedicated backup generator.</p></div><div className="panel"><h2 className="font-semibold">Free Cancellation</h2><p className="text-xs text-slate-500 mt-2">Full refund up to 7 days before check-in, under the flexible mountain weather policy.</p></div></div><Link href="/book/cedar-peak/payment-method" className="primary-button w-full">Choose Payment Method →</Link></div><BookingSummary/></div></main>;}
