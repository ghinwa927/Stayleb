"use client";
import Link from 'next/link';
import { useBooking,money } from './BookingContext';
import { BookingSummary,BookingProgress } from './BookingSummary';
import { Icon } from '@/components/ui/Icon';
export function PaymentMethod(){const {stay,update,total}=useBooking();return <main className="booking-main"><BookingProgress step={3}/><div className="booking-grid"><div><p className="text-xs text-primary uppercase tracking-wider mb-2">Secure transaction step</p><h1 className="text-3xl font-semibold">Select How You Would Like to Pay</h1><p className="text-sm text-slate-500 mt-3 mb-6">Choose between immediate confirmation via Stripe or a cash booking request requiring owner approval.</p><fieldset className="space-y-4"><legend className="sr-only">Payment method</legend>{(['Card','Cash'] as const).map(method=><label key={method} className={`panel block cursor-pointer border-2 ${stay.method===method?'border-primary':'border-transparent'}`}><div className="flex gap-3"><Icon name={method==='Card'?'credit_card':'payments'} className={method==='Card'?'text-primary':'text-amber-600'}/><div className="flex-1"><strong>{method==='Card'?'Pay Online with Stripe':'Pay Cash upon Arrival'}</strong><span className={`block text-xs mt-2 ${method==='Card'?'text-emerald-700':'text-amber-700'}`}>{method==='Card'?'Instant Automated Confirmation':'Host Approval Required'}</span><p className="text-xs text-slate-500 mt-3">{method==='Card'?'Pay securely online. Your reservation is confirmed immediately and dates are locked instantly.':'Send a formal reservation request to Tony K. Your host has 12 hours to review and accept it.'}</p></div><input type="radio" name="paymentMethod" checked={stay.method===method} onChange={()=>update({method})} className="accent-teal-700" /></div><ul className="mt-5 text-xs space-y-2 pl-9">{(method==='Card'?['100% instant booking confirmation','Secure Stripe encryption & fraud protection','Automatic digital receipt & instant check-in instructions']:['Pay USD directly to the owner at check-in','Dates temporarily held for 12 hours','Host approval required before the booking is finalized']).map(text=><li key={text}>✓ {text}</li>)}</ul></label>)}</fieldset><div className="flex flex-wrap justify-between gap-4 mt-7"><Link href="/book/cedar-peak/summary" className="secondary-button">← Back to Trip Details</Link><Link href={stay.method==='Card'?'/book/cedar-peak/payment':'/book/cedar-peak/request-sent'} className="primary-button">{stay.method==='Card'?`Continue to Secure Payment (${money(total)})`:'Send Cash Booking Request'} →</Link></div></div><BookingSummary/></div></main>;}
