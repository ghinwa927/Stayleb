"use client";
import Link from 'next/link';
import { useBooking } from './BookingContext';
import { BookingSummary,BookingProgress,PropertyIdentity } from './BookingSummary';
import { Icon } from '@/components/ui/Icon';
export function StaySelection() {const {stay,update,nights}=useBooking();const valid=nights>=2 && stay.adults+stay.children<=6;return <main className="booking-main"><BookingProgress step={1}/><div className="booking-grid"><div className="space-y-5"><div className="panel"><PropertyIdentity /></div><section className="panel"><h1 className="font-semibold flex items-center gap-2"><Icon name="calendar_month" className="text-primary" />Stay Dates</h1><div className="grid sm:grid-cols-2 gap-4 mt-5"><label className="field">Check-in<input aria-label="Check-in" type="date" value={stay.checkIn} min="2026-09-19" onChange={e=>update({checkIn:e.target.value})}/><span className="text-xs text-slate-500">From 15:00 onwards</span></label><label className="field">Check-out<input aria-label="Check-out" type="date" min={stay.checkIn} value={stay.checkOut} onChange={e=>update({checkOut:e.target.value})}/><span className="text-xs text-slate-500">Strictly before 11:00 AM</span></label></div><div className="mt-5 rounded-lg bg-surface-container-low p-4 text-sm text-white">{nights} nights selected · September mountain getaway</div></section><section className="panel"><h2 className="font-semibold flex items-center gap-2"><Icon name="group" className="text-primary"/>Guests<span className="ml-auto text-xs font-normal">Total: {stay.adults+stay.children} · Max 6</span></h2>{(['adults','children'] as const).map(key=><div key={key} className="flex justify-between items-center mt-6"><div><strong className="capitalize text-sm">{key}</strong><p className="text-xs text-slate-500">{key==='adults'?'Age 13 or above':'Ages 2–12, with guardian'}</p></div><div className="flex items-center gap-5"><button className="w-8 h-8 bg-surface-container rounded-full" aria-label={`Remove ${key}`} disabled={stay[key]<=(key==='adults'?1:0)} onClick={()=>update({[key]:stay[key]-1})}>−</button><span>{stay[key]}</span><button className="w-8 h-8 bg-surface-container rounded-full" aria-label={`Add ${key}`} disabled={stay.adults+stay.children>=6} onClick={()=>update({[key]:stay[key]+1})}>+</button></div></div>)}</section><div className={`panel text-sm ${valid?'text-primary':'text-error'}`} role="status"><Icon name={valid?'verified_user':'error'} className="align-middle mr-2" />{valid?'Minimum nights and guest capacity requirements met.':'Choose at least 2 nights and no more than 6 guests.'}</div><Link aria-disabled={!valid} onClick={e=>{if(!valid)e.preventDefault();}} href="/book/cedar-peak/summary" className={`primary-button w-full ${!valid?'opacity-50':''}`}>Continue to Price Summary <Icon name="arrow_forward" /></Link><p className="text-xs text-center text-slate-500">You won’t be charged until the final review step.</p></div><BookingSummary/></div></main>;}
