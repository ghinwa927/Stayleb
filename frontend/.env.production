# Production frontend environment (used by `next build` / Vercel production).
# Values here are PUBLIC (NEXT_PUBLIC_* is inlined into client JS).
# Local development keeps using .env.local (localhost backend).
NEXT_PUBLIC_API_URL=https://stayleb.onrender.com
# NOTE: set NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in Vercel to the LIVE
# Stripe publishable key (pk_live_...). It is intentionally absent here
# so a test key can never ship to production by accident.
