# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the production defaults file (public, non-secret values only):
# committed so builds and Vercel preview deploys share the production API URL.
# Real secrets must only ever live in Vercel dashboard environment variables.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
