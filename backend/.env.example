# StayLeb backend environment configuration.
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# (.env is git-ignored; this example file is safe to commit.)

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Environment ---
# Must be exactly "development" (default, local HTTP) or "production".
# production enables Secure refresh cookies (SameSite=None) and disables
# SQL statement logging. Any other value fails startup.
# Render production: ENVIRONMENT=production
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- CORS (frontend origins) ---
# Comma-separated list of allowed frontend origins (origin only:
# scheme + host + optional port, no trailing slash, no path, never "*").
# Local development origins (http://localhost:3000 and
# http://127.0.0.1:3000) are always allowed in addition to these.
# Production frontend origin (exact value, no trailing slash):
# CORS_ALLOWED_ORIGINS=https://stayleb.vercel.app
# NOTE: the Vercel URL above is deployment-specific. If the stable
# production frontend domain differs, use that exact origin instead.
# Set this in Render Dashboard -> Service -> Environment (triggers redeploy).
CORS_ALLOWED_ORIGINS=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- ImageKit ---
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Gemini ---
GEMINI_API_KEY=

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
